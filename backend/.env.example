# ── Server & Runtime Environment ──────────────────────
NODE_ENV=production
PORT=5000

# ── Database (Neon Serverless PostgreSQL) ─────────────
# In production, use the Neon pooled connection string with ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── JWT Authentication (Mandatory: >= 32 chars) ───────
JWT_ACCESS_SECRET="your_strong_jwt_access_secret_min_32_characters"
JWT_REFRESH_SECRET="your_strong_jwt_refresh_secret_min_32_characters"

# ── Frontend URL (CORS & Cookie Delivery) ─────────────
# Exact frontend origin WITHOUT trailing slash
FRONTEND_URL="https://your-stocksense-frontend.vercel.app"

# ── Python AI Microservice (FastAPI) ──────────────────
AI_SERVICE_URL="https://your-stocksense-ai.onrender.com"
AI_DEMAND_SERVICE_URL="https://your-stocksense-ai.onrender.com/api/ai-demand"

# ── Cloudinary Media Storage (Product Images) ─────────
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ── SMTP / Email Service (Optional for Password Resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
